# Never commit a real Canvas feed URL.
# This entire JSON value should be stored as a Cloudflare secret named
# CANVAS_CALENDAR_SOURCES.
#
# Example with one calendar:
# CANVAS_CALENDAR_SOURCES='[{"feedUrl":"https://canvas.example.edu/feeds/calendars/PRIVATE_TOKEN.ics","sourceKey":"main"}]'
#
# Example with a second calendar that belongs to one known course:
# CANVAS_CALENDAR_SOURCES='[{"feedUrl":"https://canvas.example.edu/feeds/calendars/PRIVATE_TOKEN.ics","sourceKey":"main"},{"feedUrl":"https://other.instructure.com/feeds/calendars/PRIVATE_TOKEN.ics","sourceKey":"history","defaultCourseId":"hist-201"}]'
CANVAS_CALENDAR_SOURCES=
